# Copie este arquivo para ".env" (local) ou cadastre as variáveis no painel da Netlify.
# NUNCA coloque chaves privadas, senhas ou credenciais de servidor aqui:
# tudo que começa com VITE_ é público e vai para o navegador.

# URL pública do site, sem barra no final (usada em Open Graph e canonical)
VITE_SITE_URL=

# WhatsApp da empresa: somente dígitos, com DDI e DDD. Exemplo: 5512900000000
# Se ficar vazio, o formulário mostra um aviso e não gera link.
VITE_WHATSAPP_NUMBER=

# (Opcional, futuro) Endpoint HTTPS de uma Cloud Function que valida e grava reservas no Firestore
VITE_BOOKING_API_URL=

# (Opcional, futuro) Configuração WEB do Firebase (valores públicos do app web, não são segredos de servidor)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
